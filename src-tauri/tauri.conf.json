{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FBones",
  "version": "0.9.5",
  "identifier": "studio.fbones.editor",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FBones",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false,
        "backgroundColor": "#202226"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "shortDescription": "FBones 2D animation editor",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "fileAssociations": [
      {
        "ext": [
          "fbones"
        ],
        "name": "FBones project",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwNzQzM0UzMERBQTMxOTkKUldTWk1hb040ek4wb0NkUEZEZHQ2cm1Ea3lJTWtGUFJEbEY1YnhkWGpjc3U3TkxTc0VRTk11UmYK",
      "endpoints": [
        "https://github.com/Malasuerte94/FBones/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
